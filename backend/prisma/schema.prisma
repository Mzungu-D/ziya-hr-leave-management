// use prisma-8

enum UserRole {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeaveRequestStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  LEAVE_REQUEST_CANCELLED
  LEAVE_REQUEST_REVIEW_REQUIRED
  ONBOARDING_SUBMITTED
  SYSTEM
}

enum AuthenticationMethod {
  PASSWORD
  OTP
  PASSWORD_AND_OTP
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  DEVICE_VERIFICATION
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum EmployeeDocumentType {
  PROFILE_PHOTO
  NATIONAL_ID
  PASSPORT
  KRA_PIN
  NSSF
  SHA
  HELB
  EMPLOYMENT_CONTRACT
  ACADEMIC_CERTIFICATE
  PROFESSIONAL_CERTIFICATE
  STATUTORY_DOCUMENT
  OTHER
}

enum EmployeeDocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum EmployeeDocumentAccess {
  EMPLOYEE_AND_HR
  HR_ONLY
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  COMPLETED
}

enum SystemSettingType {
  STRING
  INTEGER
  BOOLEAN
  JSON
}

model Organization {
  id        String            @id @default(uuid())
  name      String
  code      String            @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  departments  Department[]
  employees    Employee[]
  leaveTypes   LeaveType[]
  documents    EmployeeDocument[]
  policies     Policy[]
  holidays     Holiday[]
  settings     SystemSetting[]
  auditLogs    AuditLog[]
  notifications Notification[]
  onboardingSubmissions OnboardingSubmission[]

  @@index([code])
}

model Department {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  code           String

  // Explicit department leadership.
  // Nullable so existing departments can continue to exist
  // until an administrator assigns a department lead.
  departmentLeadId String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  // Employees assigned to this department.
  employees Employee[]

  // Explicit department lead.
  //
  // The backend must validate that the selected employee:
  // 1. belongs to the same organization;
  // 2. belongs to this department;
  // 3. is ACTIVE;
  // 4. has an appropriate management/HR role.
  departmentLead Employee? @relation(
    "DepartmentLead",
    fields: [departmentLeadId],
    references: [id],
    onDelete: SetNull
  )

  leaveRequests LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, departmentLeadId])
}

model Employee {
  id                   String               @id @default(uuid())
  organizationId       String
  departmentId         String?
  reportsToId          String?
  employeeId           String
  firstName            String
  lastName             String
  email                String               @unique
  phone                String               @unique
  passwordHash         String?
  role                 UserRole             @default(EMPLOYEE)
  status               AccountStatus        @default(PENDING)
  authenticationMethod AuthenticationMethod @default(PASSWORD_AND_OTP)
  emailVerified        Boolean              @default(false)
  phoneVerified        Boolean              @default(false)
  lastLoginAt          TimestamptzString?
  createdAt            TimestamptzString    @default(now())
  updatedAt            temporal.updatedAtString()

  // Current profile photo document.
  // Unique because one employee can have only one current profile photo.
  profilePictureDocumentId String? @unique

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  department Department? @relation(
    fields: [departmentId],
    references: [id]
  )

  // Employee reporting hierarchy.
  reportsTo Employee? @relation(
    "EmployeeReporting",
    fields: [reportsToId],
    references: [id],
    onDelete: SetNull
  )

  directReports Employee[] @relation("EmployeeReporting")

  // Departments where this employee is the designated department lead.
  //
  // This is intentionally separate from:
  // - department: the department the employee belongs to;
  // - reportsTo: the employee's reporting manager.
  leadDepartments Department[] @relation("DepartmentLead")

  // Current profile picture.
  profilePictureDocument EmployeeDocument? @relation(
    "EmployeeProfilePicture",
    fields: [profilePictureDocumentId],
    references: [id],
    onDelete: SetNull
  )

  // Employee HR documents.
  documents EmployeeDocument[] @relation("EmployeeDocuments")

  // Documents uploaded by this employee/HR user.
  uploadedDocuments EmployeeDocument[] @relation("UploadedEmployeeDocuments")

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  approvals     LeaveApproval[]
  invitations   ActivationInvitation[]
  otpRecords    OtpVerification[]
  sessions      UserSession[]
  auditLogs     AuditLog[] @relation("AuditLogActor")

  // Notifications addressed to this employee.
  notifications Notification[] @relation("NotificationRecipient")

  // Employee's own onboarding submission.
  onboardingSubmission OnboardingSubmission? @relation("OnboardingOwner")

  // Onboarding submissions reviewed by this HR user.
  reviewedOnboardingSubmissions OnboardingSubmission[] @relation("OnboardingReviewer")

  // Employee IDs must be unique within an organization.
  @@unique([organizationId, employeeId])

  // Production query indexes.
  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([organizationId, reportsToId])
}

model EmployeeDocument {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  uploadedById   String

  documentType EmployeeDocumentType
  status       EmployeeDocumentStatus @default(ACTIVE)
  accessLevel  EmployeeDocumentAccess @default(EMPLOYEE_AND_HR)

  name        String
  description String?

  // Private object-storage reference.
  // Never expose this value directly to the client.
  storageKey String @unique

  // Original filename is metadata only.
  // It must never be used as the storage filename.
  originalName String

  mimeType  String
  sizeBytes Int
  sha256    String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  employee Employee @relation(
    "EmployeeDocuments",
    fields: [employeeId],
    references: [id],
    onDelete: Cascade
  )

  uploadedBy Employee @relation(
    "UploadedEmployeeDocuments",
    fields: [uploadedById],
    references: [id],
    onDelete: Restrict
  )

  profileFor Employee? @relation(
    "EmployeeProfilePicture"
  )

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, documentType])
  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([uploadedById])
}

model LeaveType {
  id               String            @id @default(uuid())
  organizationId   String
  name             String
  code             String
  daysPerYear      Int
  requiresDocument Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  organization Organization  @relation(fields: [organizationId], references: [id])
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Policy {
  id             String       @id @default(uuid())
  organizationId String

  title       String
  code        String
  description String?
  content     String

  status PolicyStatus @default(DRAFT)

  version Int @default(1)

  effectiveFrom TimestamptzString?
  effectiveTo   TimestamptzString?

  publishedAt TimestamptzString?
  archivedAt   TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, effectiveFrom])
  @@index([organizationId, publishedAt])
}

model Holiday {
  id             String            @id @default(uuid())
  organizationId String

  // Human-readable holiday name.
  // Examples:
  // - Christmas Day
  // - Eid al-Fitr
  // - Diwali
  // - Independence Day
  // - Thanksgiving Day
  name String

  // Holiday date.
  //
  // The backend must normalize and validate this value before
  // creating or updating a holiday.
  date TimestamptzString

  // Optional explanation or additional calendar information.
  description String?

  // Broad classification of the holiday.
  //
  // Examples:
  // PUBLIC
  // RELIGIOUS
  // CULTURAL
  // NATIONAL
  // REGIONAL
  // COMPANY
  // OBSERVANCE
  //
  // Kept as String rather than an enum so the system can support
  // new classifications without requiring a database migration.
  category String @default("PUBLIC")

  // ISO 3166-1 alpha-2 country code when the holiday is associated
  // with a specific country.
  //
  // Examples:
  // KE
  // US
  // IN
  // SA
  //
  // Nullable because some holidays are global or organization-specific.
  countryCode String?

  // Optional region/state/province code.
  //
  // This allows the system to support local holidays without
  // restricting the schema to one country's administrative structure.
  regionCode String?

  // Indicates whether this is a religious holiday/observance.
  isReligious Boolean @default(false)

  // Optional religion identifier.
  //
  // Examples:
  // CHRISTIAN
  // ISLAM
  // JUDAISM
  // HINDU
  // SIKH
  // BUDDHIST
  // OTHER
  //
  // Nullable because public/national/company holidays are not
  // necessarily associated with a religion.
  religion String?

  // Indicates whether the holiday repeats annually.
  isRecurring Boolean @default(false)

  // Allows HR administrators to deactivate a holiday without
  // destroying historical calendar information.
  isActive Boolean @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  // Prevents the exact same holiday from being duplicated for
  // the same tenant and date while allowing multiple observances
  // to exist on the same date.
  @@unique([organizationId, name, date])

  // Production query indexes.
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@index([organizationId, countryCode])
  @@index([organizationId, regionCode])
  @@index([organizationId, religion])
}

model SystemSetting {
  id             String            @id @default(uuid())
  organizationId String
  key            String
  value          String
  type           SystemSettingType @default(STRING)
  description    String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  // Each organization can have one value for each setting key.
  @@unique([organizationId, key])

  // Production query indexes.
  @@index([organizationId])
  @@index([organizationId, type])
}

model LeaveBalance {
  id            String            @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  year          Int
  allocatedDays Int
  usedDays      Int               @default(0)
  pendingDays   Int               @default(0)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveRequest {
  id                String             @id @default(uuid())
  employeeId        String
  departmentId      String?
  leaveTypeId       String
  startDate         TimestamptzString
  endDate           TimestamptzString
  requestedDays     Int
  reason            String?
  attachmentUrl     String?
  status            LeaveRequestStatus @default(PENDING)
  submittedAt       TimestamptzString  @default(now())
  managerApprovedAt TimestamptzString?
  hrApprovedAt      TimestamptzString?
  rejectedAt        TimestamptzString?
  rejectionReason   String?
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  employee   Employee        @relation(fields: [employeeId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  leaveType  LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals  LeaveApproval[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([leaveTypeId])
}

model LeaveApproval {
  id             String            @id @default(uuid())
  leaveRequestId String
  approverId     String
  action         ApprovalAction
  comments       String?
  createdAt      TimestamptzString @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  approver     Employee     @relation(fields: [approverId], references: [id])

  @@index([leaveRequestId])
  @@index([approverId])
}

model ActivationInvitation {
  id         String           @id @default(uuid())
  employeeId String
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  TimestamptzString
  usedAt     TimestamptzString?
  createdAt  TimestamptzString @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model OtpVerification {
  id         String           @id @default(uuid())
  employeeId String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  TimestamptzString
  consumedAt TimestamptzString?
  attempts   Int              @default(0)
  createdAt  TimestamptzString @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model UserSession {
  id                String           @id @default(uuid())
  employeeId        String
  refreshTokenHash  String           @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  expiresAt         TimestamptzString
  revokedAt         TimestamptzString?
  createdAt         TimestamptzString @default(now())
  lastUsedAt        TimestamptzString?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model AuditLog {
  id             String            @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  summary        String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      TimestamptzString @default(now())

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  actor Employee? @relation(
    "AuditLogActor",
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  recipientId    String
  type           NotificationType
  title          String
  message        String
  href           String?
  readAt         TimestamptzString?
  createdAt      TimestamptzString @default(now())

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  recipient Employee @relation(
    "NotificationRecipient",
    fields: [recipientId],
    references: [id],
    onDelete: Cascade
  )

  // Efficient tenant-scoped notification feeds and unread counts.
  @@index([organizationId, recipientId, createdAt])
  @@index([organizationId, recipientId, readAt])
}

model OnboardingSubmission {
  id             String           @id @default(uuid())
  organizationId String
  employeeId     String           @unique
  status         OnboardingStatus @default(DRAFT)

  // Employee-provided onboarding information.
  employeeData Json?

  // Required employee consent records and signature information.
  consentData Json?

  // HR-only verification, employment details and final sign-off.
  hrData Json?

  submittedAt  TimestamptzString?
  reviewedAt   TimestamptzString?
  reviewedById String?
  completedAt  TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  employee Employee @relation(
    "OnboardingOwner",
    fields: [employeeId],
    references: [id],
    onDelete: Cascade
  )

  reviewedBy Employee? @relation(
    "OnboardingReviewer",
    fields: [reviewedById],
    references: [id],
    onDelete: SetNull
  )

  @@unique([organizationId, employeeId])
  @@index([organizationId, status, submittedAt], map: "onboard_org_status_submitted_idx")
  @@index([organizationId, reviewedById], map: "onboard_org_reviewer_idx")
}
