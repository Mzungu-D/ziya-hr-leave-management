// use prisma-8

enum UserRole {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeaveRequestStatus {
  PENDING
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum AuthenticationMethod {
  PASSWORD
  OTP
  PASSWORD_AND_OTP
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  DEVICE_VERIFICATION
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum EmployeeDocumentType {
  PROFILE_PHOTO
  NATIONAL_ID
  PASSPORT
  KRA_PIN
  NSSF
  SHA
  HELB
  EMPLOYMENT_CONTRACT
  ACADEMIC_CERTIFICATE
  PROFESSIONAL_CERTIFICATE
  STATUTORY_DOCUMENT
  OTHER
}

enum EmployeeDocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum EmployeeDocumentAccess {
  EMPLOYEE_AND_HR
  HR_ONLY
}

model Organization {
  id        String            @id @default(uuid())
  name      String
  code      String            @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  departments Department[]
  employees   Employee[]
  leaveTypes  LeaveType[]
  documents   EmployeeDocument[]

  @@index([code])
}

model Department {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  code           String

  // Explicit department leadership.
  // Nullable so existing departments can continue to exist
  // until an administrator assigns a department lead.
  departmentLeadId String?

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  organization  Organization @relation(fields: [organizationId], references: [id])

  // Employees assigned to this department.
  employees     Employee[]

  // Explicit department lead.
  //
  // The backend must validate that the selected employee:
  // 1. belongs to the same organization;
  // 2. belongs to this department;
  // 3. is ACTIVE;
  // 4. has an appropriate management/HR role.
  departmentLead Employee? @relation(
    "DepartmentLead",
    fields: [departmentLeadId],
    references: [id],
    onDelete: SetNull
  )

  leaveRequests LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, departmentLeadId])
}

model Employee {
  id                   String               @id @default(uuid())
  organizationId       String
  departmentId         String?
  reportsToId          String?
  employeeId           String
  firstName            String
  lastName             String
  email                String               @unique
  phone                String               @unique
  passwordHash         String?
  role                 UserRole             @default(EMPLOYEE)
  status               AccountStatus        @default(PENDING)
  authenticationMethod AuthenticationMethod @default(PASSWORD_AND_OTP)
  emailVerified        Boolean              @default(false)
  phoneVerified        Boolean              @default(false)
  lastLoginAt          TimestamptzString?
  createdAt            TimestamptzString    @default(now())
  updatedAt            temporal.updatedAtString()

  // Current profile photo document.
  // Unique because one employee can have only one current profile photo.
  profilePictureDocumentId String? @unique

  organization Organization @relation(fields: [organizationId], references: [id])

  department Department? @relation(
    fields: [departmentId],
    references: [id]
  )

  // Employee reporting hierarchy.
  reportsTo     Employee?  @relation(
    "EmployeeReporting",
    fields: [reportsToId],
    references: [id],
    onDelete: SetNull
  )

  directReports Employee[] @relation("EmployeeReporting")

  // Departments where this employee is the designated department lead.
  //
  // This is intentionally separate from:
  // - department: the department the employee belongs to;
  // - reportsTo: the employee's reporting manager.
  leadDepartments Department[] @relation("DepartmentLead")

  // Current profile picture.
  profilePictureDocument EmployeeDocument? @relation(
    "EmployeeProfilePicture",
    fields: [profilePictureDocumentId],
    references: [id],
    onDelete: SetNull
  )

  // Employee HR documents.
  documents EmployeeDocument[] @relation("EmployeeDocuments")

  // Documents uploaded by this employee/HR user.
  uploadedDocuments EmployeeDocument[] @relation("UploadedEmployeeDocuments")

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  approvals     LeaveApproval[]
  invitations   ActivationInvitation[]
  otpRecords    OtpVerification[]
  sessions      UserSession[]

  // Employee IDs must be unique within an organization.
  @@unique([organizationId, employeeId])

  // Production query indexes.
  @@index([organizationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([organizationId, reportsToId])
}

model EmployeeDocument {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  uploadedById   String

  documentType EmployeeDocumentType
  status       EmployeeDocumentStatus @default(ACTIVE)
  accessLevel  EmployeeDocumentAccess @default(EMPLOYEE_AND_HR)

  name        String
  description String?

  // Private object-storage reference.
  // Never expose this value directly to the client.
  storageKey String @unique

  // Original filename is metadata only.
  // It must never be used as the storage filename.
  originalName String

  mimeType String
  sizeBytes Int
  sha256    String

  createdAt TimestamptzString      @default(now())
  updatedAt temporal.updatedAtString()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  employee Employee @relation(
    "EmployeeDocuments",
    fields: [employeeId],
    references: [id],
    onDelete: Cascade
  )

  uploadedBy Employee @relation(
    "UploadedEmployeeDocuments",
    fields: [uploadedById],
    references: [id],
    onDelete: Restrict
  )

  profileFor Employee? @relation(
    "EmployeeProfilePicture"
  )

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, documentType])
  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([uploadedById])
}

model LeaveType {
  id               String           @id @default(uuid())
  organizationId   String
  name             String
  code             String
  daysPerYear      Int
  requiresDocument Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  organization Organization  @relation(fields: [organizationId], references: [id])
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model LeaveBalance {
  id            String           @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  year          Int
  allocatedDays Int
  usedDays      Int              @default(0)
  pendingDays   Int              @default(0)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveRequest {
  id                String             @id @default(uuid())
  employeeId        String
  departmentId      String?
  leaveTypeId       String
  startDate         TimestamptzString
  endDate           TimestamptzString
  requestedDays     Int
  reason            String?
  attachmentUrl     String?
  status            LeaveRequestStatus @default(PENDING)
  submittedAt       TimestamptzString  @default(now())
  managerApprovedAt TimestamptzString?
  hrApprovedAt      TimestamptzString?
  rejectedAt        TimestamptzString?
  rejectionReason   String?
  createdAt         TimestamptzString  @default(now())
  updatedAt         temporal.updatedAtString()

  employee   Employee        @relation(fields: [employeeId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id])
  leaveType  LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals  LeaveApproval[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([leaveTypeId])
}

model LeaveApproval {
  id             String            @id @default(uuid())
  leaveRequestId String
  approverId     String
  action         ApprovalAction
  comments       String?
  createdAt      TimestamptzString @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  approver     Employee     @relation(fields: [approverId], references: [id])

  @@index([leaveRequestId])
  @@index([approverId])
}

model ActivationInvitation {
  id         String           @id @default(uuid())
  employeeId String
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  expiresAt  TimestamptzString
  usedAt     TimestamptzString?
  createdAt  TimestamptzString @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model OtpVerification {
  id         String           @id @default(uuid())
  employeeId String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  TimestamptzString
  consumedAt TimestamptzString?
  attempts   Int              @default(0)
  createdAt  TimestamptzString @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model UserSession {
  id                String           @id @default(uuid())
  employeeId        String
  refreshTokenHash  String           @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  expiresAt         TimestamptzString
  revokedAt         TimestamptzString?
  createdAt         TimestamptzString @default(now())
  lastUsedAt        TimestamptzString?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}