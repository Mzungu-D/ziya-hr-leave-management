        "description": "create table \"EmployeeDocument\"",
        "sql": "CREATE TABLE \"public\".\"EmployeeDocument\" (\n  \"accessLevel\" text DEFAULT 'EMPLOYEE_AND_HR' NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"description\" text,\n  \"documentType\" text NOT NULL,\n  \"employeeId\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"mimeType\" text NOT NULL,\n  \"name\" text NOT NULL,\n  \"organizationId\" text NOT NULL,\n  \"originalName\" text NOT NULL,\n  \"sha256\" text NOT NULL,\n  \"sizeBytes\" int4 NOT NULL,\n  \"status\" text DEFAULT 'ACTIVE' NOT NULL,\n  \"storageKey\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"uploadedById\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"EmployeeDocument_accessLevel_check_ee3aba27\" CHECK (\"accessLevel\" IN ('EMPLOYEE_AND_HR', 'HR_ONLY')),\n  CONSTRAINT \"EmployeeDocument_documentType_check_e45d017a\" CHECK (\"documentType\" IN ('PROFILE_PHOTO', 'NATIONAL_ID', 'PASSPORT', 'KRA_PIN', 'NSSF', 'SHA', 'HELB', 'EMPLOYMENT_CONTRACT', 'ACADEMIC_CERTIFICATE', 'PROFESSIONAL_CERTIFICATE', 'STATUTORY_DOCUMENT', 'OTHER')),\n  CONSTRAINT \"EmployeeDocument_status_check_b7c57345\" CHECK (\"status\" IN ('ACTIVE', 'ARCHIVED', 'DELETED'))\n)",
        "params": []
      }
    ],
